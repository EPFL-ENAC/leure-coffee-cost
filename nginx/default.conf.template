server {
    listen       80;
    server_name  localhost;
    root   /usr/share/nginx/html;

    gzip on;
    gzip_vary on;
    gzip_comp_level 6;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml;

    # The deployment picks its dataset here, not at build time
    location = /config.json {
        default_type application/json;
        add_header Cache-Control "no-store";
        return 200 '{"dataset":"${DATASET}"}';
    }

    # Vite puts a hash in these file names, so they can be cached for a long time
    location /assets/ {
        expires 365d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Data and images keep their name between two versions, keep it short
    location / {
        expires 1h;
        add_header Cache-Control "public, must-revalidate";
        index  index.html;
        try_files $uri $uri/ /index.html;
    }
}
